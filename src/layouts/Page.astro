---
import Base from './Base.astro';
interface Props { title: string; description: string; noindex?: boolean; schema?: object[] }
const { title, description, noindex, schema } = Astro.props;
---
<Base title={title} description={description} noindex={noindex} schema={schema}>
  <div class="wrap article">
    <header class="article-head"><h1>{title}</h1></header>
    <div class="prose"><slot /></div>
  </div>
</Base>
