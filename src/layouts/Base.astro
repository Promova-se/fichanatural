---
import { site, catalog, categories, brands } from '../data/site';
import CategoryIcon from '../components/CategoryIcon.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  noindex?: boolean;
  ogImage?: string; // caminho a partir da raiz, ex.: /img/x.jpg (1200x630)
}
const { title, description, schema = [], noindex = false, ogImage } = Astro.props;
const ogImageUrl = ogImage ? new URL(ogImage, site.url).href : undefined;
const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = Astro.url.pathname === '/' ? `${site.name}: guias de suplementos sem promessa milagrosa` : (title.length + site.name.length + 3 <= 60 ? `${title} | ${site.name}` : title);
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  email: site.email,
};
const path = Astro.url.pathname;
const isProduct = path.startsWith('/produtos') || catalog.some((c) => path.startsWith(c.href));
const isCat = path.startsWith('/categoria') || path.startsWith('/marca');
const isGuide = !isProduct && ['/guias', '/laranja-moro', '/psyllium', '/resveratrol', '/ozenvitta-ou-reduphine'].some((g) => path.startsWith(g));
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="msvalidate.01" content="10717A8CEBD17F6B2ABDCF8AEE600123" />
  <meta name="google-site-verification" content="2v1CHF_hGRzBNB10ecwa-RP3ePkx-QjTigo-42DCTOg" />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta property="og:type" content="article" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
  {ogImageUrl && <meta property="og:image:width" content="1200" />}
  {ogImageUrl && <meta property="og:image:height" content="630" />}
  <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <!-- Google Analytics 4 -->
  <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4}`}></script>
  <script is:inline define:vars={{ ga4: site.ga4 }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', ga4);
    // Evento de clique nos links de afiliado (botões de compra)
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[rel~="sponsored"]');
      if (!a) return;
      gtag('event', 'clique_afiliado', {
        produto: a.dataset.produto || '',
        kit: a.dataset.kit || '',
        posicao: a.dataset.posicao || '',
        link_url: a.href,
        transport_type: 'beacon'
      });
    });
  </script>
</head>
<body>
  <a class="skip" href="#conteudo">Ir para o conteúdo</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="/" class="logo" aria-label="Ficha Natural, início">
        <span class="logo-mark" aria-hidden="true"></span>
        <span>Ficha<strong>Natural</strong></span>
      </a>
      <nav class="nav-main" aria-label="Principal">
        <div class="cat-menu" data-catmenu>
          <button type="button" class="cat-toggle" aria-expanded="false" aria-controls="cat-panel" aria-current={isCat ? 'page' : undefined}>
            Categorias
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5L6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="cat-panel" id="cat-panel">
            <div class="cat-panel-grid">
              {categories.map((c) => (
                <a class="cat-link" href={`/categoria/${c.slug}/`} style={`--cat:${c.color}`} aria-current={path.startsWith(`/categoria/${c.slug}/`) ? 'page' : undefined}>
                  <span class="cat-badge"><CategoryIcon name={c.icon} size={20} /></span>
                  <span><strong>{c.name}</strong><span class="cat-count">{c.products.length} {c.products.length === 1 ? 'produto' : 'produtos'}</span></span>
                </a>
              ))}
            </div>
            <div class="cat-panel-foot">
              <span class="cat-foot-label">Marca</span>
              {brands.map((b) => <a href={b.href}>{b.name}</a>)}
              <a class="cat-all" href="/categoria/">Todas as categorias →</a>
            </div>
          </div>
        </div>
        <a href="/produtos/" aria-current={isProduct ? 'page' : undefined}>Produtos</a>
        <a href="/guias/" aria-current={isGuide ? 'page' : undefined}>Guias</a>
        <a href="/sobre/" aria-current={path.startsWith('/sobre') ? 'page' : undefined}>Sobre</a>
      </nav>
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls="drawer" data-drawer-open>
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <span>Menu</span>
      </button>
    </div>
  </header>
  <div class="drawer-overlay" data-drawer-close></div>
  <aside class="drawer" id="drawer" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="drawer-head">
      <span class="logo"><span class="logo-mark" aria-hidden="true"></span><span>Ficha<strong>Natural</strong></span></span>
      <button type="button" class="drawer-close" data-drawer-close aria-label="Fechar menu">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>
    <p class="drawer-label">Categorias</p>
    <ul class="drawer-cats">
      {categories.map((c) => (
        <li><a href={`/categoria/${c.slug}/`} style={`--cat:${c.color}`} aria-current={path.startsWith(`/categoria/${c.slug}/`) ? 'page' : undefined}>
          <span class="cat-badge"><CategoryIcon name={c.icon} size={18} /></span>
          <span class="drawer-cat-name">{c.name}</span>
          <span class="cat-count">{c.products.length}</span>
        </a></li>
      ))}
    </ul>
    <p class="drawer-label">Marcas</p>
    <ul class="drawer-cats">
      {brands.map((b) => (
        <li><a href={b.href} style="--cat:#24513d"><span class="cat-badge"><CategoryIcon name="tag" size={18} /></span><span class="drawer-cat-name">{b.name}</span></a></li>
      ))}
    </ul>
    <ul class="drawer-links">
      <li><a href="/produtos/">Todas as fichas</a></li>
      <li><a href="/guias/">Guias</a></li>
      <li><a href="/sobre/">Sobre e política editorial</a></li>
    </ul>
  </aside>
  <script is:inline>
  (function () {
    // Menu de categorias (desktop)
    var menu = document.querySelector('[data-catmenu]');
    if (menu) {
      var btn = menu.querySelector('.cat-toggle');
      var t;
      var set = function (open) { menu.classList.toggle('open', open); btn.setAttribute('aria-expanded', open ? 'true' : 'false'); };
      var hoverAt = 0;
      btn.addEventListener('click', function () {
        if (Date.now() - hoverAt < 400) return; // acabou de abrir pelo mouse; o clique não deve fechar
        set(!menu.classList.contains('open'));
      });
      if (window.matchMedia('(hover: hover)').matches) {
        menu.addEventListener('mouseenter', function () { clearTimeout(t); if (!menu.classList.contains('open')) hoverAt = Date.now(); set(true); });
        menu.addEventListener('mouseleave', function () { t = setTimeout(function () { set(false); }, 180); });
      }
      document.addEventListener('click', function (e) { if (!menu.contains(e.target)) set(false); });
      menu.addEventListener('keydown', function (e) { if (e.key === 'Escape') { set(false); btn.focus(); } });
      menu.addEventListener('focusout', function (e) { if (!menu.contains(e.relatedTarget)) set(false); });
    }
    // Gaveta lateral (mobile)
    var drawer = document.getElementById('drawer');
    var opener = document.querySelector('[data-drawer-open]');
    if (!drawer || !opener) return;
    var focusables = function () { return drawer.querySelectorAll('a[href], button'); };
    var open = function () {
      document.documentElement.classList.add('drawer-on');
      opener.setAttribute('aria-expanded', 'true');
      setTimeout(function () { drawer.querySelector('.drawer-close').focus(); }, 50);
    };
    var close = function () {
      if (!document.documentElement.classList.contains('drawer-on')) return;
      document.documentElement.classList.remove('drawer-on');
      opener.setAttribute('aria-expanded', 'false');
      opener.focus();
    };
    opener.addEventListener('click', open);
    document.querySelectorAll('[data-drawer-close]').forEach(function (el) { el.addEventListener('click', close); });
    document.addEventListener('keydown', function (e) {
      if (!document.documentElement.classList.contains('drawer-on')) return;
      if (e.key === 'Escape') { close(); return; }
      if (e.key === 'Tab') {
        var f = focusables(); var first = f[0]; var last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });
    window.matchMedia('(min-width: 721px)').addEventListener('change', function (m) { if (m.matches) close(); });
  })();
  </script>
  <main id="conteudo">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <p class="logo footer-logo"><span class="logo-mark" aria-hidden="true"></span><span>Ficha<strong>Natural</strong></span></p>
        <p>{site.tagline}</p>
        <p class="small">O conteúdo deste site é informativo e não substitui a orientação de médico ou nutricionista.</p>
      </div>
      <div>
        <p class="footer-title">Produtos</p>
        <ul>
          {catalog.map((c) => <li><a href={c.href}>{c.name}</a></li>)}
          <li><a href="/produtos/">Todas as fichas</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-title">Categorias</p>
        <ul>
          {categories.map((c) => <li><a href={`/categoria/${c.slug}/`}>{c.name}</a></li>)}
          {brands.map((b) => <li><a href={b.href}>{b.name}</a></li>)}
        </ul>
        <p class="footer-title footer-title-2">Guias</p>
        <ul>
          <li><a href="/ozenvitta-ou-reduphine/">OzenVitta ou ReduPhine</a></li>
          <li><a href="/laranja-moro/">Laranja moro</a></li>
          <li><a href="/psyllium/">Psyllium</a></li>
          <li><a href="/resveratrol/">Resveratrol</a></li>
          <li><a href="/guias/">Todos os guias</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-title">Institucional</p>
        <ul>
          <li><a href="/sobre/">Sobre e política editorial</a></li>
          <li><a href="/aviso-de-afiliado/">Aviso de afiliado</a></li>
          <li><a href="/privacidade/">Privacidade</a></li>
          <li><a href="/contato/">Contato</a></li>
        </ul>
      </div>
    </div>
    <div class="wrap small footer-legal">
      <p>Somos afiliados: quando você compra por um link nosso, podemos receber comissão, sem custo extra para você. Não vendemos nem entregamos produtos. Mantido por {site.company}, CNPJ {site.cnpj}.</p>
    </div>
  </footer>
</body>
</html>
